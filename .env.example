# Copy to .env and fill in real values. Never commit .env.
# docker-compose.yml reads this file for the container; export the DB_*/JWT_*
# values into your shell when running the API locally (see README quickstart).

# --- Postgres connection parts ---
# POSTGRES_HOST is the host as seen by the API: localhost for local runs,
# the compose service name (db) if the API itself ever runs in Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartos
POSTGRES_USER=smartos
POSTGRES_PASSWORD=change-me-strong-password

# --- Backend datasource (keep in sync with the parts above, or point at a remote DB) ---
DB_URL=jdbc:postgresql://localhost:5432/smartos
DB_USER=smartos
DB_PASSWORD=change-me-strong-password

# --- Auth (must be >= 256-bit / 32+ random bytes; e.g. openssl rand -base64 32) ---
JWT_SECRET=REPLACE_WITH_32B_PLUS_BASE64_SECRET

# --- Web origins allowed by CORS ---
CORS_ORIGINS=http://localhost:3000
